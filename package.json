{
  "name": "braveheart-databricks",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling for commit message linting. The project itself is one YAML file; see README.md.",
  "type": "module",
  "scripts": {
    "commitlint": "commitlint",
    "test:commitlint": "node --test \"tools/commitlint/*.test.mjs\" && bash scripts/test-commitlint.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
